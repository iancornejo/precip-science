---
// precip.science header: the drop mark as the logo, the nav (D25: Products · About), and the
// link back to Ian's personal site with its radar mark.
import DropMark from "./DropMark.astro";
import RadarMark from "./RadarMark.astro";
import Icon from "./Icon.astro";
import { SITE } from "../lib/site";

const links = [
  { href: "/products/", label: "Products" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname.replace(/index\.html$/, "");
---
<div class="container">
<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>
    <DropMark size={24} />
    <span>{SITE.name}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>{l.label}</a></li>
      ))}
      <li>
        <a class="nav-home" href={SITE.ownerUrl}>
          <RadarMark size={18} />{SITE.owner}<Icon name="external" size={12} />
        </a>
      </li>
    </ul>
  </nav>
</header>
</div>
