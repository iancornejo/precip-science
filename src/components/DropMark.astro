---
// precip.science's mark (the drop favicon without its tile), used where this site links there.
import { DROP_DOME, DROP_WAVE } from "../lib/dropmark";
interface Props { size?: number; class?: string }
const { size = 14, class: cls } = Astro.props;
---
<svg class={cls} height={size} width={(size * 68) / 35} viewBox="-2 16 68 35" aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg">
  <path fill={DROP_DOME.fill} d={DROP_DOME.d} />
  <path d={DROP_WAVE.d}
    stroke={DROP_WAVE.stroke} stroke-width={DROP_WAVE.width} stroke-linecap="round" stroke-linejoin="round" fill="none" />
</svg>
