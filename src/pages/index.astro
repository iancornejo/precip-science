---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Notice from "../components/Notice.astro";
import { SITE, STAGES } from "../lib/site";
import sample from "../assets/figures/sample-echo-type.png";

const products = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);
// The status line under the lead names the furthest-along product.
const furthest = (["live", "in-development", "planned", "exploratory", "feasibility-study"] as const)
  .map((s) => products.find((p) => p.data.stage === s))
  .find(Boolean);
const classes = [
  { label: "Stratiform", color: "var(--ecco-stratiform)" },
  { label: "Mixed", color: "var(--ecco-mixed)" },
  { label: "Convective", color: "var(--ecco-convective)" },
];
---
<Base>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-text">
      <p class="caps">{SITE.tagline}</p>
      <h1 id="hero-h">Echo classification, storm objects and microphysical fingerprints</h1>
      <p class="lead">Unofficial, experimental products built on NOAA’s MRMS radar mosaic with EccoPy and LROSE, by <a class="link" href={SITE.ownerUrl}>{SITE.owner}</a>.</p>
      {furthest && (
        <a class="status-chip" href={`/products/${furthest.id}/`}>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill={STAGES[furthest.data.stage].color} /></svg>
          {furthest.data.title} · {STAGES[furthest.data.stage].label}
        </a>
      )}
    </div>
    <figure class="hero-fig">
      <div class="fig-frame">
        <Image src={sample} widths={[640, 960, 1440]} sizes="(max-width: 1000px) 100vw, 720px" loading="eager"
          alt="Echo-type map over the central Plains and upper Midwest: an arc of convective cells along the derecho's leading line, edged by mixed echo, with stratiform rain around and behind it." />
      </div>
      <ul class="legend" aria-label="Echo types">
        {classes.map((c) => <li><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect width="14" height="14" fill={c.color} /></svg>{c.label}</li>)}
      </ul>
      <figcaption>Sample frame: EccoPy 2D echo type on the MRMS composite, 15 Dec 2021, 22:38 UTC, during the serial derecho. Colors are EccoPy’s defaults.</figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="products-h">
    <h2 id="products-h" class="section-label">Products</h2>
    <ul class="cards">
      {products.map((p) => <ProductCard product={p} />)}
    </ul>
  </section>

  <Notice />
</Base>
